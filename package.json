{
  "name": "golf2025",
  "version": "1.0.0",
  "description": "Golf scoring and statistics application",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint superb_ock/static/superb_ock/js/**/*.js",
    "lint:fix": "eslint superb_ock/static/superb_ock/js/**/*.js --fix",
    "format": "prettier --write \"superb_ock/static/superb_ock/{js,css}/**/*.{js,css}\"",
    "build:css": "sass superb_ock/static/superb_ock/scss/custom-bootstrap.scss superb_ock/static/superb_ock/css/bootstrap-custom.css --style compressed",
    "build:css:dev": "sass superb_ock/static/superb_ock/scss/custom-bootstrap.scss superb_ock/static/superb_ock/css/bootstrap-custom.css --watch",
    "build": "npm run build:css"
  },
  "keywords": ["golf", "scoring", "statistics"],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@babel/core": "^7.23.7",
    "@babel/preset-env": "^7.23.7",
    "@testing-library/dom": "^9.3.4",
    "@testing-library/jest-dom": "^6.1.5",
    "babel-jest": "^29.7.0",
    "bootstrap": "^5.3.2",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.1.1",
    "sass": "^1.69.5"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": ["<rootDir>/superb_ock/static/superb_ock/js/tests/setup.js"],
    "testMatch": ["**/__tests__/**/*.test.js", "**/?(*.)+(spec|test).js"],
    "transform": {
      "^.+\\.js$": "babel-jest"
    },
    "collectCoverageFrom": [
      "superb_ock/static/superb_ock/js/modules/**/*.js",
      "!superb_ock/static/superb_ock/js/tests/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    }
  },
  "babel": {
    "presets": [
      ["@babel/preset-env", {
        "targets": {
          "node": "current"
        }
      }]
    ]
  }
}
